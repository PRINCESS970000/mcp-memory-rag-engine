# Copy this file to .env and fill in real values. Never commit the real .env.

# Used by rag/generate.py and the LLM-based Self-RAG support check.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Used by planning/cli.py and agent/planning_agent.py for every algorithm
# in the Planning Agent (decomposition, Plan-and-Solve, Tree of Thoughts,
# LATS, Self-Refine, Reflexion) -- all through one consistent
# langchain-mistralai client.
MISTRAL_API_KEY=your_mistral_key_here
